generator client {
  provider            = "prisma-client"
  output              = "../src/shared/infrastructure/persistence/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Catálogo de ubicaciones del contexto Referencias Operativas.
model OperationalLocation {
  id        String                 @id
  label     String
  floor     Int
  equipment OperationalEquipment[]

  @@map("operational_locations")
}

model OperationalEquipment {
  id              String              @id
  name            String
  category        String
  brand           String
  model           String
  assetCode       String              @unique
  location        String
  locationId      String
  catalogLocation OperationalLocation @relation(fields: [locationId], references: [id])
  maintenance     MaintenanceRecord[]

  @@index([locationId])
  @@map("operational_equipment")
}

model OperationalSymptom {
  id    String @id
  label String @unique

  @@map("operational_symptoms")
}

model OperationalStation {
  id       String  @id
  label    String
  location String?
  floor    Int
  ip       String?

  @@map("operational_stations")
}

model MaintenanceRecord {
  id          String               @id
  equipmentId String
  date        DateTime             @db.Date
  type        String
  details     String
  technician  String
  status      String
  equipment   OperationalEquipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId, date])
  @@map("maintenance_records")
}

model DemoUser {
  id           String @id
  name         String
  role         String
  passwordHash String

  @@map("demo_users")
}

/// Incidencias conserva el contexto registrado y referencia los catálogos por ID.
model EquipmentIncident {
  number        Int      @id @default(autoincrement())
  equipmentId   String
  equipmentName String
  locationId    String
  locationLabel String
  floor         Int
  symptomId     String
  symptomLabel  String
  reporterId    String
  reporterName  String
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@map("equipment_incidents")
}

model ITAlert {
  number         Int       @id @default(autoincrement())
  stationId      String
  location       String
  floor          Int
  ip             String?
  reporterId     String
  reporterName   String
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([reporterId, createdAt])
  @@map("it_alerts")
}

enum GeneralServicesPriority {
  Critical
  High
  Medium
  Low
}

model GeneralServicesIncident {
  id           String                  @id
  title        String
  incidentType String
  description  String
  symptom      String
  location     String
  floor        Int
  priority     GeneralServicesPriority
  reportedBy   String
  createdAt    DateTime
  closedAt     DateTime?

  @@index([closedAt])
  @@map("general_services_incidents")
}
