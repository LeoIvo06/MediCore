{
  "name": "medicore-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "generate": "prisma generate",
    "predev": "npm run generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/ArchitectureTest.ts test/IncidentAccessPolicyTest.ts test/EquipmentIncidentCommandServiceTest.ts",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.4",
    "prisma": "7.8.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
